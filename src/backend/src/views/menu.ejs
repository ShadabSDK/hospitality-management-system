<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= restaurant.name %> - Menu</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #f5f5f5;
            color: #333;
            line-height: 1.6;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            min-height: 100vh;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 1.5rem;
            text-align: center;
        }
        .header h1 {
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }
        .header p {
            opacity: 0.9;
            font-size: 0.9rem;
        }
        .menu-content {
            padding: 1.5rem;
        }
        .category {
            margin-bottom: 2rem;
        }
        .category-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #333;
            border-bottom: 2px solid #667eea;
            padding-bottom: 0.5rem;
        }
        .dish {
            background: #f9f9f9;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            display: flex;
            gap: 1rem;
        }
        .dish-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
            flex-shrink: 0;
        }
        .dish-info {
            flex: 1;
        }
        .dish-name {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #333;
        }
        .dish-description {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 0.5rem;
        }
        .dish-price {
            font-size: 1.2rem;
            font-weight: 600;
            color: #667eea;
        }
        .unavailable {
            opacity: 0.6;
            position: relative;
        }
        .unavailable::after {
            content: 'Unavailable';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            font-weight: 600;
        }
        .footer {
            text-align: center;
            padding: 2rem;
            color: #666;
            font-size: 0.9rem;
        }
        @media (max-width: 480px) {
            .dish {
                flex-direction: column;
            }
            .dish-image {
                width: 100%;
                height: 200px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><%= restaurant.name %></h1>
            <% if (restaurant.description) { %>
                <p><%= restaurant.description %></p>
            <% } %>
        </div>
        
        <div class="menu-content">
            <% categories.forEach(function(category) { %>
                <div class="category">
                    <h2 class="category-title"><%= category.name %></h2>
                    <% if (category.dishes && category.dishes.length > 0) { %>
                        <% category.dishes.forEach(function(dish) { %>
                            <div class="dish <%= !dish.isAvailable ? 'unavailable' : '' %>">
                                <% if (dish.imageUrl) { %>
                                    <img src="<%= dish.imageUrl %>" alt="<%= dish.name %>" class="dish-image" />
                                <% } %>
                                <div class="dish-info">
                                    <div class="dish-name"><%= dish.name %></div>
                                    <% if (dish.description) { %>
                                        <div class="dish-description"><%= dish.description %></div>
                                    <% } %>
                                    <div class="dish-price">$<%= dish.price.toFixed(2) %></div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p style="color: #999; font-style: italic;">No dishes available in this category</p>
                    <% } %>
                </div>
            <% }); %>
        </div>
        
        <div class="footer">
            <p>Scan QR code to view this menu</p>
        </div>
    </div>
</body>
</html>

