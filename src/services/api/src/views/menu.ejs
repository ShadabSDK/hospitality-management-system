<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= restaurant.name %> - Menu</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #f5f5f5;
      color: #333;
    }

    .container {
      max-width: 100%;
      margin: 0 auto;
      background: white;
    }

    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px 20px;
      text-align: center;
    }

    .header h1 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .header p {
      font-size: 16px;
      opacity: 0.9;
    }

    .menu-content {
      padding: 20px;
      max-width: 900px;
      margin: 0 auto;
    }

    .category {
      margin-bottom: 40px;
    }

    .category-title {
      font-size: 24px;
      color: #667eea;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #667eea;
    }

    .dish {
      background: #f9f9f9;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 8px;
      border-left: 4px solid #667eea;
    }

    .dish-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 8px;
    }

    .dish-name {
      font-size: 18px;
      font-weight: bold;
      color: #333;
    }

    .dish-price {
      font-size: 18px;
      font-weight: bold;
      color: #667eea;
    }

    .dish-description {
      font-size: 14px;
      color: #666;
      margin-bottom: 8px;
    }

    .dish-image {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 4px;
      margin-bottom: 10px;
    }

    .badge {
      display: inline-block;
      background: #667eea;
      color: white;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      margin-right: 5px;
    }

    .unavailable {
      opacity: 0.6;
      text-decoration: line-through;
    }

    .footer {
      text-align: center;
      padding: 20px;
      color: #999;
      font-size: 12px;
    }

    @media (max-width: 600px) {
      .header h1 {
        font-size: 24px;
      }

      .menu-content {
        padding: 15px;
      }

      .dish {
        padding: 12px;
      }

      .dish-name {
        font-size: 16px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <% if (restaurant.logo) { %>
        <img src="<%= restaurant.logo %>" alt="<%= restaurant.name %>" style="height: 60px; margin-bottom: 20px; border-radius: 4px;">
      <% } %>
      <h1><%= restaurant.name %></h1>
      <% if (restaurant.description) { %>
        <p><%= restaurant.description %></p>
      <% } %>
    </div>

    <div class="menu-content">
      <% categories.forEach(category => { %>
        <div class="category">
          <h2 class="category-title"><%= category.name %></h2>
          <% 
            const categoryDishes = dishes.filter(d => d.categoryId.toString() === category._id.toString());
            categoryDishes.forEach(dish => {
          %>
            <div class="dish <%= !dish.isAvailable ? 'unavailable' : '' %>">
              <% if (dish.image) { %>
                <img src="<%= dish.image %>" alt="<%= dish.name %>" class="dish-image">
              <% } %>
              <div class="dish-header">
                <div>
                  <div class="dish-name"><%= dish.name %></div>
                  <% if (dish.description) { %>
                    <div class="dish-description"><%= dish.description %></div>
                  <% } %>
                </div>
                <div class="dish-price">₹<%= dish.price %></div>
              </div>
              <% if (dish.tags && dish.tags.length > 0) { %>
                <div>
                  <% dish.tags.forEach(tag => { %>
                    <span class="badge"><%= tag %></span>
                  <% }); %>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% }); %>
    </div>

    <div class="footer">
      <p>Powered by Restaurant Digital Menu</p>
      <p>Generated on <%= new Date().toLocaleDateString() %></p>
    </div>
  </div>
</body>
</html>
